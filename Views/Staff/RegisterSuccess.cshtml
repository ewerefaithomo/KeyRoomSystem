@{
    ViewData["Title"] = "Registration Successful";
    Layout = null;
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        Key Room Management System - Registration Successful
    </title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>

        body {
            background-color: #f4f8f6;
            font-family: Arial, Helvetica, sans-serif;
            margin: 0;
        }

        .top-header {
            background-color: #198754;
            color: white;
            padding: 18px 30px;
        }

        .system-name {
            font-size: 25px;
            font-weight: 700;
        }

        .system-subtitle {
            font-size: 14px;
            opacity: 0.9;
        }

        .success-container {
            max-width: 650px;
            margin: 80px auto;
            padding: 20px;
        }

        .success-card {
            background-color: white;
            border-radius: 12px;
            padding: 50px 35px;
            text-align: center;
            box-shadow: 0 4px 18px rgba(0,0,0,0.08);
        }

        .success-icon {
            font-size: 80px;
            color: #198754;
            margin-bottom: 20px;
        }

        .success-title {
            color: #198754;
            font-weight: 700;
            margin-bottom: 15px;
        }

        .success-message {
            font-size: 18px;
            color: #495057;
            margin-bottom: 30px;
        }

        .footer {
            text-align: center;
            margin-top: 40px;
            color: #6c757d;
            font-size: 13px;
        }

    </style>

</head>

<body>


    <!-- HEADER -->

    <div class="top-header">

        <div class="container-fluid">

            <div class="system-name">
                Key Room Management System
            </div>

            <div class="system-subtitle">
                Key Issuance, Collection and Monitoring
            </div>

        </div>

    </div>


    <!-- SUCCESS -->

    <div class="success-container">

        <div class="success-card">

            <div class="success-icon">

                <i class="bi bi-check-circle-fill"></i>

            </div>


            <h2 class="success-title">

                Staff registration is successful

            </h2>


            <p class="success-message">

                The staff member has been successfully registered
                in the Key Room Staff Register.

            </p>


            <div class="d-flex justify-content-center gap-2">

                <a asp-controller="Staff"
                   asp-action="Search"
                   class="btn btn-success">

                    <i class="bi bi-person-plus-fill"></i>

                    Register Another Staff

                </a>


                <a asp-controller="Dashboard"
                   asp-action="Index"
                   class="btn btn-secondary">

                    <i class="bi bi-speedometer2"></i>

                    Dashboard

                </a>

            </div>

        </div>


        <div class="footer">

            Key Room Management System

            <br />

            ICT Unit

        </div>

    </div>


</body>

</html>