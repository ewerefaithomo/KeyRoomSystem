@model IEnumerable<KeyRoomSystem.Models.KeyItem>

@{
    ViewData["Title"] = "Registered Keys";
    Layout = null;
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Registered Keys - Key Room Management System</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>

        body {
            background-color: #f1f8f4;
            font-family: Arial, Helvetica, sans-serif;
        }

        .header {
            background-color: #198754;
            color: white;
            padding: 25px 0;
            margin-bottom: 30px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.12);
        }

        .content-card {
            background: white;
            border-radius: 12px;
            padding: 25px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        }

        .page-title {
            color: #198754;
            font-weight: 700;
        }

        .table thead th {
            background-color: #198754;
            color: white;
            vertical-align: middle;
        }

        .table tbody td {
            vertical-align: middle;
        }

        .status-available {
            color: #198754;
            font-weight: 600;
        }

        .status-collected {
            color: #dc3545;
            font-weight: 600;
        }

        .empty-message {
            padding: 40px;
            text-align: center;
            color: #6c757d;
        }

        .key-number {
            font-weight: 700;
            color: #198754;
        }

    </style>

</head>

<body>

    <!-- HEADER -->

    <div class="header">

        <div class="container">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h2 class="mb-1">

                        <i class="bi bi-key-fill"></i>

                        Key Room Management System

                    </h2>

                    <p class="mb-0">

                        Registered Keys

                    </p>

                </div>


                <div>

                    <a asp-controller="Dashboard"
                       asp-action="Index"
                       class="btn btn-light">

                        <i class="bi bi-speedometer2"></i>

                        Dashboard

                    </a>

                </div>

            </div>

        </div>

    </div>


    <!-- CONTENT -->

    <div class="container">

        <div class="content-card">


            <!-- PAGE HEADING -->

            <div class="d-flex justify-content-between align-items-center mb-4">

                <div>

                    <h3 class="page-title mb-1">

                        <i class="bi bi-list-ul"></i>

                        Registered Keys

                    </h3>

                    <p class="text-muted mb-0">

                        List of keys registered in the Key Room.

                    </p>

                </div>


                <a asp-controller="Keys"
                   asp-action="Create"
                   class="btn btn-success">

                    <i class="bi bi-plus-circle"></i>

                    Register New Key

                </a>

            </div>


            <!-- SUCCESS MESSAGE -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show"
                     role="alert">

                    <i class="bi bi-check-circle-fill"></i>

                    @TempData["SuccessMessage"]

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert">
                    </button>

                </div>
            }


            <!-- KEYS TABLE -->
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-bordered table-hover align-middle">

                        <thead>

                            <tr>

                                <th style="width: 70px;">
                                    #
                                </th>

                                <th>
                                    Key Number
                                </th>

                                <th>
                                    Room Name
                                </th>

                                <th>
                                    Description
                                </th>

                                <th style="width: 150px;">
                                    Status
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @{
                                int serialNumber = 1;
                            }

                            @foreach (var key in Model)
                            {
                                <tr>

                                    <td>
                                        @serialNumber
                                    </td>

                                    <td>
                                        <span class="key-number">
                                            @key.KeyNumber
                                        </span>
                                    </td>

                                    <td>
                                        @key.RoomName
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(key.Description)
                                                                        ? "-"
                                                                        : key.Description)
                            </td>

                                    <td>

                                @if (key.IsAvailable)
                                        {
                                            <span class="status-available">

                                                <i class="bi bi-check-circle-fill"></i>

                                                Available

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-collected">

                                                <i class="bi bi-dash-circle-fill"></i>

                                                Collected

                                            </span>
                                        }

                                    </td>

                                </tr>

                                serialNumber++;
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="empty-message">

                    <i class="bi bi-key"
                       style="font-size: 50px;">
                    </i>

                    <h5 class="mt-3">
                        No Keys Registered
                    </h5>

                    <p>
                        There are currently no keys registered in the system.
                    </p>

                    <a asp-controller="Keys"
                       asp-action="Create"
                       class="btn btn-success">

                        <i class="bi bi-plus-circle"></i>

                        Register First Key

                    </a>

                </div>
            }

        </div>

    </div>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

</body>

</html>