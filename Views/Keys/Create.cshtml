@model KeyRoomSystem.Models.KeyItem

@{
    ViewData["Title"] = "Register New Key";
    Layout = null;
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Register New Key - Key Room Management System</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>

        body {
            background-color: #f4f8f6;
            font-family: Arial, Helvetica, sans-serif;
        }

        .top-header {
            background-color: #198754;
            color: white;
            padding: 18px 30px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.12);
        }

        .system-name {
            font-size: 24px;
            font-weight: 700;
        }

        .system-subtitle {
            font-size: 14px;
            opacity: 0.9;
        }

        .page-container {
            max-width: 800px;
            margin: 40px auto;
            padding: 0 20px;
        }

        .form-card {
            background: white;
            border-radius: 12px;
            padding: 35px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        }

        .page-title {
            color: #198754;
            font-weight: 700;
            margin-bottom: 5px;
        }

        .page-description {
            color: #6c757d;
            margin-bottom: 30px;
        }

        .form-label {
            font-weight: 600;
            color: #343a40;
        }

        .form-control {
            min-height: 45px;
            border-radius: 7px;
        }

            .form-control:focus {
                border-color: #198754;
                box-shadow: 0 0 0 0.2rem rgba(25,135,84,0.15);
            }

        .readonly-field {
            background-color: #e9f5ee;
            font-weight: 600;
            color: #198754;
        }

        .btn-save {
            background-color: #198754;
            color: white;
            border: none;
            min-width: 150px;
        }

            .btn-save:hover {
                background-color: #146c43;
                color: white;
            }

        .btn-cancel {
            min-width: 150px;
        }

        .required {
            color: red;
        }

        .system-generated {
            font-size: 13px;
            color: #6c757d;
            margin-top: 6px;
        }

    </style>

</head>

<body>



    <!-- HEADER -->

    <div class="top-header">

        <div class="container-fluid">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <div class="system-name">
                        Key Room Management System
                    </div>

                    <div class="system-subtitle">
                        Key Registration and Inventory Management
                    </div>

                </div>

                <div>

                    <a asp-controller="Dashboard"
                       asp-action="Index"
                       class="btn btn-outline-light">

                        <i class="bi bi-speedometer2"></i>
                        Dashboard

                    </a>

                </div>

            </div>

        </div>

    </div>


    <!-- PAGE -->

    <div class="page-container">

        <div class="form-card">

            <h2 class="page-title">
                Register New Key
            </h2>

            <p class="page-description">
                Enter the details of the new key to add it to the Key Room inventory.
            </p>


            <!-- Validation -->

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger"
                 role="alert">
            </div>


            <form asp-controller="Keys"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()


                <!-- KEY NUMBER -->

                <div class="mb-4">

                    <label asp-for="KeyNumber"
                           class="form-label">

                        Key Number

                    </label>

                    <input asp-for="KeyNumber"
                           class="form-control readonly-field"
                           readonly />

                    <div class="system-generated">

                        <i class="bi bi-info-circle"></i>

                        Key Number is automatically generated by the system
                        from the unique database ID and cannot be edited.

                    </div>

                    <span asp-validation-for="KeyNumber"
                          class="text-danger">
                    </span>

                </div>


                <!-- ROOM NAME -->

                <div class="mb-4">

                    <label asp-for="RoomName"
                           class="form-label">

                        Room Name
                        <span class="required">*</span>

                    </label>

                    <input asp-for="RoomName"
                           class="form-control"
                           placeholder="Enter room name"
                           autocomplete="off" />

                    <span asp-validation-for="RoomName"
                          class="text-danger">
                    </span>

                </div>


                <!-- DESCRIPTION -->

                <div class="mb-4">

                    <label asp-for="Description"
                           class="form-label">

                        Description

                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4"
                              placeholder="Enter description or location of the key"></textarea>

                    <span asp-validation-for="Description"
                          class="text-danger">
                    </span>

                </div>


                <!-- STATUS -->

                <div class="mb-4">

                    <label class="form-label">
                        Key Status
                    </label>

                    <div class="alert alert-success mb-0">

                        <i class="bi bi-check-circle-fill"></i>

                        This key will be registered as
                        <strong>Available</strong>.

                    </div>

                </div>


                <!-- BUTTONS -->

                <div class="d-flex gap-2 mt-4">

                    <button type="submit"
                            class="btn btn-save">

                        <i class="bi bi-save"></i>
                        Register Key

                    </button>


                    <a asp-controller="Dashboard"
                       asp-action="Index"
                       class="btn btn-outline-secondary btn-cancel">

                        <i class="bi bi-x-circle"></i>
                        Cancel

                    </a>

                </div>

            </form>

        </div>

    </div>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    <partial name="_ValidationScriptsPartial" />

</body>

</html>