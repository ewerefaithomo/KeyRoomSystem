@model KeyRoomSystem.Models.ReportViewModel

@{
    ViewData["Title"] = "Reports";
    Layout = null;
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        Key Room Management System - Reports
    </title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>

        body {
            background-color: #f4f8f6;
            font-family: Arial, Helvetica, sans-serif;
            margin: 0;
        }

        .top-header {
            background-color: #198754;
            color: white;
            padding: 18px 30px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.12);
        }

        .system-name {
            font-size: 25px;
            font-weight: 700;
        }

        .system-subtitle {
            font-size: 14px;
            opacity: 0.9;
        }

        .page-container {
            max-width: 1400px;
            margin: 35px auto;
            padding: 0 20px;
        }

        .page-title {
            color: #198754;
            font-weight: 700;
        }

        .report-card {
            background-color: white;
            border-radius: 12px;
            padding: 25px;
            box-shadow: 0 3px 12px rgba(0,0,0,0.08);
        }

        .report-title {
            color: #198754;
            font-weight: 700;
        }

        .table-container {
            background-color: white;
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 3px 12px rgba(0,0,0,0.08);
            margin-top: 25px;
        }

        .table thead th {
            background-color: #198754;
            color: white;
            vertical-align: middle;
            white-space: nowrap;
        }

        .table tbody td {
            vertical-align: middle;
        }

        .status-collected {
            color: #dc3545;
            font-weight: 700;
        }

        .status-returned {
            color: #198754;
            font-weight: 700;
        }

        .empty-state {
            padding: 50px;
            text-align: center;
            color: #6c757d;
        }

            .empty-state i {
                font-size: 55px;
                color: #198754;
                margin-bottom: 15px;
            }

        .total-box {
            background-color: #f0f8f4;
            border-left: 5px solid #198754;
            padding: 15px;
            margin-top: 20px;
        }

        .footer {
            text-align: center;
            margin-top: 45px;
            padding: 20px;
            color: #6c757d;
            font-size: 13px;
        }

        .print-only {
            display: none;
        }

        
        @@media print {
            body

        {
            background-color: white;
        }

        .top-header,
        .report-controls,
        .action-buttons,
        .footer {
            display: none !important;
        }

        .page-container {
            max-width: 100%;
            margin: 0;
            padding: 0;
        }

        .table-container {
            box-shadow: none;
            padding: 0;
            margin-top: 20px;
        }

        .print-only {
            display: block;
        }

        .table {
            font-size: 11px;
        }

            .table thead th {
                background-color: #198754 !important;
                color: white !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }

        .report-title {
            color: black;
        }

        }
    </style>

</head>

<body>


    <!-- =========================================================
         HEADER
         ========================================================= -->

    <div class="top-header">

        <div class="container-fluid">

            <div class="d-flex justify-content-between
                        align-items-center">

                <div>

                    <div class="system-name">
                        Key Room Management System
                    </div>

                    <div class="system-subtitle">
                        Key Issuance, Collection and Monitoring
                    </div>

                </div>

                <div>

                    <a asp-controller="Dashboard"
                       asp-action="Index"
                       class="btn btn-outline-light">

                        <i class="bi bi-speedometer2"></i>

                        Dashboard

                    </a>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         MAIN CONTENT
         ========================================================= -->

    <div class="page-container">

        <div class="mb-4">

            <h2 class="page-title">

                <i class="bi bi-bar-chart-fill"></i>

                Key Room Reports

            </h2>

            <p class="text-muted">

                Generate, print and export Key Room operational reports.

            </p>

        </div>


        <!-- =====================================================
             REPORT SELECTION
             ===================================================== -->

        <div class="report-card report-controls">

            <form asp-controller="Reports"
                  asp-action="Index"
                  method="get">

                <div class="row g-3 align-items-end">


                    <!-- REPORT TYPE -->

                    <div class="col-md-5">

                        <label for="reportType"
                               class="form-label fw-bold">

                            Select Report

                        </label>

                        <select id="reportType"
                                name="reportType"
                                class="form-select">

                            <option value="not-returned-today"
                                    selected="@(Model.ReportType == "not-returned-today")">

                                Details of Keys Not Returned for Today

                            </option>

                            <option value="not-returned-period"
                                    selected="@(Model.ReportType == "not-returned-period")">

                                Details of Keys Not Returned for Specified Period

                            </option>

                            <option value="collected-period"
                                    selected="@(Model.ReportType == "collected-period")">

                                Report of Keys Collected for Specified Period

                            </option>

                        </select>

                    </div>


                    <!-- START DATE -->

                    <div class="col-md-3">

                        <label for="startDate"
                               class="form-label fw-bold">

                            Start Date

                        </label>

                        <input type="date"
                               id="startDate"
                               name="startDate"
                               class="form-control"
                               value="@Model.StartDate.ToString("yyyy-MM-dd")" />

                    </div>


                    <!-- END DATE -->

                    <div class="col-md-3">

                        <label for="endDate"
                               class="form-label fw-bold">

                            End Date

                        </label>

                        <input type="date"
                               id="endDate"
                               name="endDate"
                               class="form-control"
                               value="@Model.EndDate.ToString("yyyy-MM-dd")" />

                    </div>


                    <!-- GENERATE -->

                    <div class="col-md-1">

                        <button type="submit"
                                class="btn btn-success w-100">

                            <i class="bi bi-search"></i>

                        </button>

                    </div>

                </div>

            </form>

        </div>


        <!-- =====================================================
             REPORT HEADING
             ===================================================== -->

        <div class="table-container">

            <div class="d-flex justify-content-between
                        align-items-center
                        flex-wrap
                        gap-3
                        mb-3">

                <div>

                    <h4 class="report-title mb-1">

                        @Model.ReportTitle

                    </h4>

                    <div class="text-muted">

                        @if (Model.ReportType ==
                                                "not-returned-today")
                        {
                            <span>
                                Date:
                                @Model.StartDate.ToString("dd/MM/yyyy")
                            </span>
                        }
                        else
                        {
                            <span>
                                Period:
                                @Model.StartDate.ToString("dd/MM/yyyy")
                                -
                                @Model.EndDate.ToString("dd/MM/yyyy")
                            </span>
                        }

                    </div>

                </div>


                <!-- =================================================
                     ACTION BUTTONS
                     ================================================= -->

                <div class="action-buttons d-flex gap-2">

                    <!-- PRINT -->

                    <button type="button"
                            class="btn btn-outline-success"
                            onclick="window.print();">

                        <i class="bi bi-printer"></i>

                        Print

                    </button>


                    <!-- EXCEL -->

                    <a asp-controller="Reports"
                       asp-action="ExportExcel"
                       asp-route-reportType="@Model.ReportType"
                       asp-route-startDate="@Model.StartDate.ToString("yyyy-MM-dd")"
                       asp-route-endDate="@Model.EndDate.ToString("yyyy-MM-dd")"
                       class="btn btn-success">

                        <i class="bi bi-file-earmark-excel"></i>

                        Export to Excel

                    </a>

                </div>

            </div>


            <!-- =====================================================
                 TOTAL RECORDS
                 ===================================================== -->

            <div class="total-box">

                <strong>
                    Total Records:
                </strong>

                <span class="ms-2">

                    @Model.TotalRecords

                </span>

            </div>


            <!-- =====================================================
                 REPORT TABLE
                 ===================================================== -->
            @if (Model.Transactions != null &&
                        Model.Transactions.Any())
            {

                <div class="table-responsive mt-4">

                    <table class="table table-bordered
                                      table-hover
                                      table-striped">

                        <thead>

                            <tr>

                                <th>
                                    S/N
                                </th>

                                <th>
                                    Key Number
                                </th>

                                <th>
                                    Room Name
                                </th>

                                <th>
                                    Staff Number
                                </th>

                                <th>
                                    Staff Name
                                </th>

                                <th>
                                    Department
                                </th>

                                <th>
                                    Date Collected
                                </th>

                                <th>
                                    Date Returned
                                </th>

                                <th>
                                    Status
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @{
                                int serialNumber = 1;
                            }

                            @foreach (var transaction
                                                    in Model.Transactions)
                            {

                                <tr>

                                    <td>
                                        @serialNumber
                                    </td>

                                    <td class="fw-bold">
                                        @transaction.KeyItem?.KeyNumber
                                    </td>

                                    <td>
                                        @transaction.KeyItem?.RoomName
                                    </td>

                                    <td>
                                        @transaction.StaffNumber
                                    </td>

                                    <td>
                                        @(transaction.Staff?.FullName
                                                                        ?? "(Name not provided)")
                                                                                             </td>

                                    <td>
                                        @(transaction.Staff?.Department
                                                                        ?? "(Department not provided)")
                            </td>

                                                                    <td>
                                                                        @transaction.DateCollected.ToString(
                                                                        "dd/MM/yyyy HH:mm")
                            </td>

                                    <td>

                                @if (transaction.DateReturned.HasValue)
                                        {
                                            @transaction.DateReturned.Value.ToString(
                                            "dd/MM/yyyy HH:mm")
                                                                }
                                        else
                                        {
                                            <span class="text-danger fw-bold">
                                                Not Returned
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        @if (transaction.Status ==
                                                                        "Collected")
                                        {
                                            <span class="status-collected">

                                                <i class="bi bi-clock-history"></i>

                                                Collected

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-returned">

                                                <i class="bi bi-check-circle"></i>

                                                @transaction.Status

                                            </span>
                                        }

                                    </td>

                                </tr>

                                serialNumber++;
                            }

                        </tbody>

                    </table>

                </div>

            }
            else
            {

                <div class="empty-state">

                    <i class="bi bi-file-earmark-bar-graph"></i>

                    <h5>
                        No Records Found
                    </h5>

                    <p>
                        There are no records matching the selected
                        report criteria.
                    </p>

                </div>

            }

        </div>


        <!-- =====================================================
             FOOTER
             ===================================================== -->

        <div class="footer">

            Key Room Management System

            <br />

            ICT Unit

        </div>

    </div>


    <!-- =========================================================
         JAVASCRIPT
         ========================================================= -->

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const reportType =
                    document.getElementById("reportType");

                const startDate =
                    document.getElementById("startDate");

                const endDate =
                    document.getElementById("endDate");


                function updateDateFields() {

                    if (reportType.value ===
                        "not-returned-today") {

                        startDate.disabled = true;
                        endDate.disabled = true;

                    }
                    else {

                        startDate.disabled = false;
                        endDate.disabled = false;

                    }

                }


                reportType.addEventListener(
                    "change",
                    updateDateFields
                );


                updateDateFields();

            });

    </script>

</body>

</html>