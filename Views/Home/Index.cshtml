@{
    ViewData["Title"] = "Home";
    Layout = null;
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        University of Benin Teaching Hospital - Key Room Management System
    </title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/ubth-brand.css" />

    <style>

        body {
            margin: 0;
            min-height: 100vh;
            background: #f4f8f6;
            font-family: Arial, Helvetica, sans-serif;
        }

        .home-header {
            background: #198754;
            padding: 18px 30px;
        }

        .home-container {
            min-height: calc(100vh - 120px);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 30px;
        }

        .home-card {
            max-width: 800px;
            width: 100%;
            background: #ffffff;
            border-radius: 15px;
            padding: 50px;
            text-align: center;
            box-shadow: 0 5px 25px rgba(0, 0, 0, 0.10);
        }

        .home-logo {
            width: 160px;
            height: 160px;
            object-fit: contain;
            margin-bottom: 20px;
        }

        .hospital-name {
            color: #198754;
            font-size: 28px;
            font-weight: 800;
        }

        .system-name {
            color: #343a40;
            font-size: 23px;
            font-weight: 700;
            margin-top: 10px;
        }

        .description {
            color: #6c757d;
            margin-top: 15px;
        }

        .login-button {
            margin-top: 25px;
            padding: 12px 35px;
            font-weight: 600;
        }

        @@media (max-width: 600px) {
            .home-card

        {
            padding: 30px 20px;
        }

        .hospital-name {
            font-size: 21px;
        }

        .system-name {
            font-size: 18px;
        }

        }
    </style>

</head>

<body>


    <div class="home-header">

        <div class="container-fluid">

            <div class="ubth-brand">

                <div class="ubth-logo-container">

                    <img src="~/images/ubth-logo.jpeg"
                         alt="University of Benin Teaching Hospital Logo"
                         class="ubth-logo" />

                </div>

                <div class="ubth-name-container">

                    <div class="ubth-name">
                        UNIVERSITY OF BENIN TEACHING HOSPITAL
                    </div>

                    <div class="ubth-system-name">
                        KEY ROOM MANAGEMENT SYSTEM
                    </div>

                </div>

            </div>

        </div>

    </div>


    <div class="home-container">

        <div class="home-card">

            <img src="~/images/ubth-logo.jpeg"
                 alt="University of Benin Teaching Hospital Logo"
                 class="home-logo" />


            <div class="hospital-name">
                UNIVERSITY OF BENIN TEACHING HOSPITAL
            </div>


            <div class="system-name">
                KEY ROOM MANAGEMENT SYSTEM
            </div>


            <p class="description">
                A computerized system for the registration,
                issuance, collection, return and monitoring of
                hospital keys.
            </p>


            <a asp-controller="Account"
               asp-action="Login"
               class="btn btn-success login-button">

                Login to System

            </a>

        </div>

    </div>

</body>

</html>