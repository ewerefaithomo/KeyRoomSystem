@using KeyRoomSystem.Models

@{
    Layout = null;

    var keys = ViewBag.Keys as List<KeyItem>
               ?? new List<KeyItem>();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Collect Key - Key Room Management System</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
        body {
            background-color: #f4f8f5;
            font-family: Arial, Helvetica, sans-serif;
        }

        .header {
            background-color: #198754;
            color: white;
            padding: 20px 30px;
        }

        .header-title {
            font-size: 24px;
            font-weight: bold;
        }

        .header-subtitle {
            font-size: 14px;
            opacity: 0.9;
        }

        .container-box {
            max-width: 900px;
            margin: 35px auto;
        }

        .card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 3px 15px rgba(0, 0, 0, 0.08);
        }

        .card-header {
            background-color: #198754;
            color: white;
            font-weight: bold;
            font-size: 18px;
        }

        .form-label {
            font-weight: 600;
        }

        .info-box {
            background-color: #e9f7ef;
            border-left: 5px solid #198754;
            padding: 15px;
            border-radius: 6px;
        }

        .warning-box {
            background-color: #fff3cd;
            border-left: 5px solid #ffc107;
            padding: 15px;
            border-radius: 6px;
        }

        .btn-success {
            padding-left: 25px;
            padding-right: 25px;
        }

        .staff-search-wrapper {
            position: relative;
        }

        .staff-results {
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            z-index: 1050;
            background: white;
            border: 1px solid #ced4da;
            border-radius: 6px;
            margin-top: 4px;
            max-height: 280px;
            overflow-y: auto;
            box-shadow: 0 5px 14px rgba(0, 0, 0, 0.12);
        }

        .staff-result {
            padding: 11px 14px;
            cursor: pointer;
            border-bottom: 1px solid #eeeeee;
        }

            .staff-result:last-child {
                border-bottom: none;
            }

            .staff-result:hover,
            .staff-result.active {
                background-color: #e9f7ef;
            }

        .staff-result-name {
            font-weight: 600;
            color: #198754;
        }

        .staff-result-details {
            font-size: 13px;
            color: #555555;
            margin-top: 3px;
        }

        .staff-selected {
            background-color: #e9f7ef;
            border: 1px solid #198754;
            padding: 12px;
            border-radius: 6px;
            margin-top: 10px;
        }

        .search-status {
            font-size: 13px;
            margin-top: 6px;
            color: #555555;
        }

        [hidden] {
            display: none !important;
        }
    </style>
</head>

<body>
    <div class="header">
        <div class="container-fluid d-flex
                    justify-content-between align-items-center">
            <div>
                <div class="header-title">
                    Key Room Management System
                </div>
                <div class="header-subtitle">
                    Key Collection Transaction
                </div>
            </div>

            <a asp-controller="Dashboard"
               asp-action="Index"
               class="btn btn-light">
                Dashboard
            </a>
        </div>
    </div>

    <div class="container container-box">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show"
                 role="alert">
                <strong>Success!</strong>
                @TempData["SuccessMessage"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show"
                 role="alert">
                <strong>Error!</strong>
                @TempData["ErrorMessage"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close"></button>
            </div>
        }

        <div class="info-box mb-4">
            <strong>Key Collection</strong>
            <p class="mb-0 mt-1">
                Select the key and search for the staff member by
                name, staff number, or department. Select the correct
                staff record before recording the transaction.
            </p>
        </div>

        @if (!keys.Any())
        {
            <div class="alert alert-warning">
                <h5>No Available Keys</h5>
                <p>
                    There are currently no keys available for collection.
                </p>

                <a asp-controller="Keys"
                   asp-action="Create"
                   class="btn btn-success">
                    Register New Key
                </a>
            </div>
        }
        else
        {
            <div class="card">
                <div class="card-header">
                    Record Key Collection
                </div>

                <div class="card-body p-4">
                    <form asp-controller="Transactions"
                          asp-action="Collect"
                          method="post"
                          id="collectKeyForm">

                        @Html.AntiForgeryToken()

                        <div class="mb-4">
                            <label for="keyId" class="form-label">
                                Select Key
                            </label>

                            <select id="keyId"
                                    name="keyId"
                                    class="form-select"
                                    required>
                                <option value="">-- Select Key --</option>

                                @foreach (var key in keys)
                                {
                                    <option value="@key.Id">
                                        Key @key.KeyNumber - @key.RoomName
                                        @if (!string.IsNullOrWhiteSpace(
                                                                        key.Description))
                                        {
                                            @: (@key.Description)
                                        }
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="mb-4">
                            <label for="staffSearch"
                                   class="form-label">
                                Staff Member Collecting Key
                            </label>

                            <div class="staff-search-wrapper">
                                <input type="search"
                                       id="staffSearch"
                                       class="form-control"
                                       placeholder="Type staff name or staff number..."
                                       autocomplete="off"
                                       spellcheck="false"
                                       aria-autocomplete="list"
                                       aria-controls="staffResults"
                                       aria-expanded="false"
                                       aria-describedby="staffSearchStatus"
                                       required />

                                <div id="staffResults"
                                     class="staff-results"
                                     role="listbox"
                                     hidden>
                                </div>
                            </div>

                            <div id="staffSearchStatus"
                                 class="search-status"
                                 aria-live="polite">
                                Enter at least two characters to search.
                            </div>

                            <input type="hidden"
                                   id="staffNumber"
                                   name="staffNumber"
                                   value="" />

                            <div id="selectedStaff"
                                 class="staff-selected"
                                 hidden>
                                <strong>Selected Staff:</strong>
                                <span id="selectedStaffName"></span>
                                <button type="button"
                                        id="changeStaff"
                                        class="btn btn-sm btn-outline-success float-end">
                                    Change
                                </button>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="collectionDate"
                                   class="form-label">
                                Date and Time
                            </label>

                            <input type="text"
                                   id="collectionDate"
                                   class="form-control"
                                   value="@DateTime.Now.ToString("dd/MM/yyyy hh:mm tt")"
                                   readonly />
                        </div>

                        <div class="warning-box mb-4">
                            <strong>Important:</strong>
                            Once recorded, the selected key will be marked
                            as <strong>Collected</strong> and will not
                            appear among available keys until returned.
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-controller="Dashboard"
                               asp-action="Index"
                               class="btn btn-secondary">
                                Cancel
                            </a>

                            <button type="submit"
                                    id="submitCollection"
                                    class="btn btn-success">
                                Record Key Collection
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        }
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        (() => {
            "use strict";

            const searchInput =
                document.getElementById("staffSearch");

            const resultsBox =
                document.getElementById("staffResults");

            const statusText =
                document.getElementById("staffSearchStatus");

            const staffNumberInput =
                document.getElementById("staffNumber");

            const selectedStaffBox =
                document.getElementById("selectedStaff");

            const selectedStaffName =
                document.getElementById("selectedStaffName");

            const changeStaffButton =
                document.getElementById("changeStaff");

            const form =
                document.getElementById("collectKeyForm");

            if (!searchInput || !form) {
                return;
            }

            let debounceTimer = null;
            let activeController = null;
            let requestNumber = 0;
            let activeIndex = -1;
            let currentResults = [];

            function closeResults() {
                resultsBox.hidden = true;
                resultsBox.replaceChildren();
                searchInput.setAttribute("aria-expanded", "false");
                activeIndex = -1;
            }

            function setStatus(message) {
                statusText.textContent = message;
            }

            function clearSelection() {
                staffNumberInput.value = "";
                selectedStaffBox.hidden = true;
                selectedStaffName.textContent = "";
            }

            function renderResults(staffList) {
                resultsBox.replaceChildren();
                currentResults = staffList;
                activeIndex = -1;

                if (!staffList.length) {
                    closeResults();
                    setStatus("No matching staff member found.");
                    return;
                }

                staffList.forEach((staff, index) => {
                    const option = document.createElement("div");

                    option.className = "staff-result";
                    option.setAttribute("role", "option");
                    option.setAttribute("aria-selected", "false");
                    option.id = "staff-option-" + index;

                    const name = document.createElement("div");
                    name.className = "staff-result-name";
                    name.textContent =
                        staff.fullName || "Name not recorded";

                    const details = document.createElement("div");
                    details.className = "staff-result-details";

                    const parts = [
                        "Staff No: " + (staff.staffNumber || "")
                    ];

                    if (staff.department) {
                        parts.push(staff.department);
                    }

                    details.textContent = parts.join(" | ");

                    option.append(name, details);

                    // mousedown prevents the input losing focus
                    // before the selection is processed.
                    option.addEventListener("mousedown", event => {
                        event.preventDefault();
                        selectStaff(staff);
                    });

                    resultsBox.appendChild(option);
                });

                resultsBox.hidden = false;
                searchInput.setAttribute("aria-expanded", "true");
                setStatus(staffList.length + " matching result(s).");
            }

            function selectStaff(staff) {
                if (!staff || !staff.staffNumber) {
                    return;
                }

                clearTimeout(debounceTimer);

                if (activeController) {
                    activeController.abort();
                    activeController = null;
                }

                staffNumberInput.value = staff.staffNumber;

                const name = staff.fullName || "Name not recorded";
                const department = staff.department
                    ? " (" + staff.department + ")"
                    : "";

                selectedStaffName.textContent =
                    name + " - " + staff.staffNumber + department;

                searchInput.value =
                    name + " - " + staff.staffNumber;

                selectedStaffBox.hidden = false;

                closeResults();

                setStatus("Staff member selected successfully.");
            }

            function updateActiveOption() {
                const options =
                    resultsBox.querySelectorAll(".staff-result");

                options.forEach((option, index) => {
                    const isActive = index === activeIndex;

                    option.classList.toggle("active", isActive);
                    option.setAttribute(
                        "aria-selected",
                        isActive ? "true" : "false");
                });

                if (activeIndex >= 0 && options[activeIndex]) {
                    options[activeIndex].scrollIntoView({
                        block: "nearest"
                    });
                }
            }

            async function searchStaff(term, currentRequest) {
                if (activeController) {
                    activeController.abort();
                }

                activeController = new AbortController();

                setStatus("Searching staff records...");

                try {
                    const url = '@Url.Action("SearchStaff", "Transactions")'
                        + '?term=' + encodeURIComponent(term);

                    const response = await fetch(url, {
                        method: "GET",
                        headers: {
                            "Accept": "application/json"
                        },
                        credentials: "same-origin",
                        signal: activeController.signal
                    });

                    if (currentRequest !== requestNumber) {
                        return;
                    }

                    if (response.status === 401) {
                        closeResults();
                        setStatus(
                            "Your session has expired. Please log in again.");
                        return;
                    }

                    if (!response.ok) {
                        throw new Error("Staff search failed.");
                    }

                    const staffList = await response.json();

                    if (currentRequest !== requestNumber) {
                        return;
                    }

                    renderResults(staffList);
                }
                catch (error) {
                    if (error.name === "AbortError") {
                        return;
                    }

                    if (currentRequest !== requestNumber) {
                        return;
                    }

                    closeResults();
                    setStatus(
                        "Unable to search staff records. Please try again.");
                }
            }

            searchInput.addEventListener("input", () => {
                clearSelection();
                clearTimeout(debounceTimer);

                const term = searchInput.value.trim();
                const currentRequest = ++requestNumber;

                if (activeController) {
                    activeController.abort();
                    activeController = null;
                }

                closeResults();

                if (term.length < 2) {
                    setStatus(
                        "Enter at least two characters to search.");
                    return;
                }

                // Debounce typing to reduce unnecessary database requests.
                debounceTimer = setTimeout(() => {
                    searchStaff(term, currentRequest);
                }, 180);
            });

            searchInput.addEventListener("keydown", event => {
                if (resultsBox.hidden || !currentResults.length) {
                    return;
                }

                if (event.key === "ArrowDown") {
                    event.preventDefault();

                    activeIndex = Math.min(
                        activeIndex + 1,
                        currentResults.length - 1);

                    updateActiveOption();
                }
                else if (event.key === "ArrowUp") {
                    event.preventDefault();

                    activeIndex = Math.max(activeIndex - 1, 0);
                    updateActiveOption();
                }
                else if (event.key === "Enter" && activeIndex >= 0) {
                    event.preventDefault();
                    selectStaff(currentResults[activeIndex]);
                }
                else if (event.key === "Escape") {
                    closeResults();
                }
            });

            changeStaffButton.addEventListener("click", () => {
                clearSelection();
                searchInput.value = "";
                searchInput.focus();
                setStatus("Search for the next staff member.");
            });

            document.addEventListener("click", event => {
                if (!event.target.closest(".staff-search-wrapper")) {
                    closeResults();
                }
            });

            form.addEventListener("submit", event => {
                if (!staffNumberInput.value.trim()) {
                    event.preventDefault();

                    setStatus(
                        "Please select a staff member from the search results.");

                    searchInput.focus();
                }
            });
        })();
    </script>
</body>
</html>
