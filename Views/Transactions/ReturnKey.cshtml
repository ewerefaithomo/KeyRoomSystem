@model IEnumerable<KeyRoomSystem.Models.KeyTransaction>

@{
    ViewData["Title"] = "Return Keys";
    Layout = null;
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        Key Room Management System - Return Keys
    </title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>

        body {
            background-color: #f4f8f6;
            font-family: Arial, Helvetica, sans-serif;
            margin: 0;
        }

        /* =====================================================
                   HEADER
                   ===================================================== */

        .top-header {
            background-color: #198754;
            color: white;
            padding: 18px 30px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
        }

        .system-name {
            font-size: 25px;
            font-weight: 700;
        }

        .system-subtitle {
            font-size: 14px;
            opacity: 0.9;
        }

        .header-btn {
            color: white;
            border: 1px solid rgba(255, 255, 255, 0.7);
            margin-left: 8px;
        }

            .header-btn:hover {
                background-color: white;
                color: #198754;
            }

        /* =====================================================
                   MAIN CONTAINER
                   ===================================================== */

        .page-container {
            max-width: 1250px;
            margin: 35px auto;
            padding: 0 20px;
        }

        /* =====================================================
                   PAGE TITLE
                   ===================================================== */

        .page-title {
            color: #198754;
            font-weight: 700;
            margin-bottom: 5px;
        }

        .page-subtitle {
            color: #6c757d;
            margin-bottom: 25px;
        }

        /* =====================================================
                   INFORMATION BOX
                   ===================================================== */

        .info-box {
            background-color: #e8f5ee;
            border-left: 5px solid #198754;
            padding: 15px 18px;
            border-radius: 6px;
            margin-bottom: 25px;
        }

            .info-box strong {
                color: #146c43;
            }

        /* =====================================================
                   CARD
                   ===================================================== */

        .table-card {
            background-color: white;
            border-radius: 10px;
            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08);
            overflow: hidden;
        }

        .table-header {
            background-color: #198754;
            color: white;
            padding: 16px 20px;
            font-size: 18px;
            font-weight: 700;
        }

        /* =====================================================
                   TABLE
                   ===================================================== */

        .table {
            margin-bottom: 0;
        }

            .table thead th {
                background-color: #f0f7f3;
                color: #198754;
                font-weight: 700;
                white-space: nowrap;
                border-bottom: 2px solid #198754;
            }

            .table tbody td {
                vertical-align: middle;
            }

        .key-number {
            font-weight: 700;
            color: #198754;
        }

        .staff-name {
            font-weight: 600;
        }

        .staff-number {
            font-size: 13px;
            color: #6c757d;
        }

        .status-badge {
            background-color: #fff3cd;
            color: #856404;
            padding: 6px 10px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
        }

        /* =====================================================
                   RETURN BUTTON
                   ===================================================== */

        .return-btn {
            min-width: 120px;
        }

        /* =====================================================
                   EMPTY STATE
                   ===================================================== */

        .empty-state {
            text-align: center;
            padding: 60px 20px;
        }

        .empty-icon {
            font-size: 60px;
            color: #198754;
            margin-bottom: 15px;
        }

        .empty-title {
            font-size: 21px;
            font-weight: 700;
            color: #212529;
        }

        .empty-text {
            color: #6c757d;
            margin-top: 8px;
        }

        /* =====================================================
                   FOOTER
                   ===================================================== */

        .footer {
            text-align: center;
            margin-top: 45px;
            padding: 20px;
            color: #6c757d;
            font-size: 13px;
        }

        /* =====================================================
                   RESPONSIVE
                   ===================================================== */

        @@media (max-width: 768px) {
            .system-name

        {
            font-size: 19px;
        }

        .system-subtitle {
            font-size: 12px;
        }

        .top-header {
            padding: 15px;
        }

        .page-container {
            margin-top: 25px;
        }

        }
    </style>

</head>

<body>


    <!-- =====================================================
         HEADER
         ===================================================== -->

    <div class="top-header">

        <div class="container-fluid">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <div class="system-name">
                        Key Room Management System
                    </div>

                    <div class="system-subtitle">
                        Key Issuance, Collection and Monitoring
                    </div>

                </div>


                <div>

                    <a asp-controller="Dashboard"
                       asp-action="Index"
                       class="btn header-btn">

                        <i class="bi bi-speedometer2"></i>

                        Dashboard

                    </a>


                    <a asp-controller="Account"
                       asp-action="Logout"
                       class="btn header-btn">

                        <i class="bi bi-box-arrow-right"></i>

                        Logout

                    </a>

                </div>

            </div>

        </div>

    </div>



    <!-- =====================================================
         MAIN PAGE
         ===================================================== -->

    <div class="page-container">


        <!-- PAGE TITLE -->

        <div>

            <h2 class="page-title">

                <i class="bi bi-box-arrow-up"></i>

                Return Keys

            </h2>

            <p class="page-subtitle">

                Manage the return of keys currently collected by
                hospital staff.

            </p>

        </div>



        <!-- =================================================
             SUCCESS MESSAGE
             ================================================= -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show"
                 role="alert">

                <i class="bi bi-check-circle-fill"></i>

                <strong>Success:</strong>

                @TempData["SuccessMessage"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>

            </div>
        }



        <!-- =================================================
             ERROR MESSAGE
             ================================================= -->
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show"
                 role="alert">

                <i class="bi bi-exclamation-triangle-fill"></i>

                <strong>Error:</strong>

                @TempData["ErrorMessage"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>

            </div>
        }



        <!-- =================================================
             INFORMATION
             ================================================= -->

        <div class="info-box">

            <i class="bi bi-info-circle-fill text-success"></i>

            <strong>Return Process:</strong>

            Select the
            <strong>Return Key</strong>
            button beside the key being returned.

            The system will mark the transaction as
            <strong>Returned</strong>,
            record the return date and time, and make the key
            available for collection again.

        </div>



        <!-- =================================================
             ACTIVE COLLECTIONS
             ================================================= -->
        @if (Model != null && Model.Any())
        {

            <div class="table-card">


                <div class="table-header">

                    <i class="bi bi-list-check"></i>

                    Currently Collected Keys

                </div>



                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>

                            <tr>

                                <th>
                                    #
                                </th>

                                <th>
                                    Key Number
                                </th>

                                <th>
                                    Room
                                </th>

                                <th>
                                    Staff Number
                                </th>

                                <th>
                                    Staff Name
                                </th>

                                <th>
                                    Department
                                </th>

                                <th>
                                    Date Collected
                                </th>

                                <th>
                                    Status
                                </th>

                                <th class="text-center">
                                    Action
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @{
                                int serialNumber = 1;
                            }

                            @foreach (var transaction in Model)
                            {

                                <tr>

                                    <!-- SERIAL NUMBER -->

                                    <td>

                                        @serialNumber

                                    </td>


                                    <!-- KEY NUMBER -->

                                    <td>

                                        <span class="key-number">

                                            Key @transaction.KeyItem?.KeyNumber

                                        </span>

                                    </td>


                                    <!-- ROOM -->

                                    <td>

                                        @transaction.KeyItem?.RoomName

                                    </td>


                                    <!-- STAFF NUMBER -->

                                    <td>

                                        <span class="staff-number">

                                            @transaction.StaffNumber

                                        </span>

                                    </td>


                                    <!-- STAFF NAME -->

                                    <td>

                                        <span class="staff-name">

                                            @transaction.Staff?.FullName

                                        </span>

                                    </td>


                                    <!-- DEPARTMENT -->

                                    <td>

                                        @transaction.Staff?.Department

                                    </td>


                                    <!-- DATE COLLECTED -->

                                    <td>

                                        @transaction.DateCollected.ToString(
                                        "dd-MMM-yyyy hh:mm tt")

                            </td>


                            <!-- STATUS -->

                            <td>

                                <span class="status-badge">

                                    <i class="bi bi-clock-history"></i>

                                    @transaction.Status

                                </span>

                            </td>


                            <!-- ACTION -->

                            <td class="text-center">

                                <form asp-controller="Transactions"
                                      asp-action="ProcessReturn"
                                      method="post"
                                      onsubmit="return confirmReturn('@transaction.KeyItem?.KeyNumber');">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@transaction.Id" />

                                    <button type="submit"
                                            class="btn btn-success return-btn">

                                        <i class="bi bi-box-arrow-up"></i>

                                        Return Key

                                    </button>

                                </form>

                            </td>

                        </tr>

                                                serialNumber++;

                            }

                        </tbody>

                    </table>

                </div>

            </div>

        }
        else
        {

            <!-- =================================================
                 NO ACTIVE COLLECTIONS
                 ================================================= -->

            <div class="table-card">

                <div class="empty-state">

                    <div class="empty-icon">

                        <i class="bi bi-check-circle"></i>

                    </div>

                    <div class="empty-title">

                        No Keys Currently Collected

                    </div>

                    <div class="empty-text">

                        All registered keys are currently available
                        in the Key Room.

                    </div>

                    <div class="mt-4">

                        <a asp-controller="Transactions"
                           asp-action="Collect"
                           class="btn btn-success">

                            <i class="bi bi-key-fill"></i>

                            Collect a Key

                        </a>

                    </div>

                </div>

            </div>

        }



        <!-- =================================================
             FOOTER
             ================================================= -->

        <div class="footer">

            Key Room Management System

            <br />

            ICT Unit

        </div>


    </div>



    <!-- =====================================================
         BOOTSTRAP JAVASCRIPT
         ===================================================== -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>


    <!-- =====================================================
         RETURN CONFIRMATION
         ===================================================== -->

    <script>

        function confirmReturn(keyNumber) {

            return confirm(
                "Are you sure you want to record the return of Key Number "
                + keyNumber
                + "?"
            );

        }

    </script>


</body>

</html>