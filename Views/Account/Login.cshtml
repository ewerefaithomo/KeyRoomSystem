@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        Login - Key Room Management System
    </title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/ubth-brand.css" />

    <style>

        body {
            margin: 0;
            padding: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f2f8f5;
            font-family: Arial, Helvetica, sans-serif;
        }

        .login-container {
            width: 100%;
            max-width: 470px;
            padding: 20px;
        }

        .login-card {
            background: #ffffff;
            border-radius: 14px;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
            padding: 35px;
        }

        .ubth-login-brand {
            text-align: center;
            margin-bottom: 25px;
        }

        .ubth-login-logo {
            width: 125px;
            height: 125px;
            object-fit: contain;
            margin-bottom: 10px;
        }

        .ubth-login-hospital {
            color: #198754;
            font-size: 20px;
            font-weight: 800;
            line-height: 1.3;
        }

        .ubth-login-system {
            color: #6c757d;
            font-size: 15px;
            font-weight: 600;
            margin-top: 6px;
        }

        .system-subtitle {
            text-align: center;
            color: #6c757d;
            font-size: 13px;
            margin-bottom: 25px;
        }

        .form-label {
            font-weight: 600;
            color: #343a40;
        }

        .form-control {
            height: 46px;
            border-radius: 7px;
        }

            .form-control:focus {
                border-color: #198754;
                box-shadow: 0 0 0 0.2rem rgba(25, 135, 84, 0.15);
            }

        .btn-login {
            background-color: #198754;
            border-color: #198754;
            color: #ffffff;
            height: 45px;
            font-weight: 600;
        }

            .btn-login:hover {
                background-color: #146c43;
                border-color: #146c43;
                color: #ffffff;
            }

        .btn-cancel {
            height: 45px;
            font-weight: 600;
        }

        .footer-text {
            text-align: center;
            margin-top: 25px;
            font-size: 12px;
            color: #6c757d;
        }

    </style>

</head>

<body>

    <div class="login-container">

        <div class="login-card">

            <!-- =====================================================
                 UBTH BRANDING
                 ===================================================== -->

            <div class="ubth-login-brand">

                <img src="~/images/ubth-logo.jpeg"
                     alt="University of Benin Teaching Hospital Logo"
                     class="ubth-login-logo" />

                <div class="ubth-login-hospital">
                    UNIVERSITY OF BENIN TEACHING HOSPITAL
                </div>

                <div class="ubth-login-system">
                    KEY ROOM MANAGEMENT SYSTEM
                </div>

            </div>


            <div class="system-subtitle">
                Please enter your login credentials
            </div>


            <!-- =====================================================
                 LOGIN FORM
                 ===================================================== -->

            <form asp-action="Login" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <div class="mb-3">

                    <label for="Username"
                           class="form-label">
                        Username
                    </label>

                    <input type="text"
                           id="Username"
                           name="Username"
                           class="form-control"
                           placeholder="Enter username"
                           autocomplete="username"
                           required />

                </div>


                <div class="mb-4">

                    <label for="Password"
                           class="form-label">
                        Password
                    </label>

                    <input type="password"
                           id="Password"
                           name="Password"
                           class="form-control"
                           placeholder="Enter password"
                           autocomplete="current-password"
                           required />

                </div>


                <div class="row g-2">

                    <div class="col-6">

                        <button type="submit"
                                class="btn btn-login w-100">
                            Login
                        </button>

                    </div>


                    <div class="col-6">

                        <button type="button"
                                class="btn btn-outline-secondary btn-cancel w-100"
                                onclick="window.location.href='@Url.Action("Index", "Home")'">
                            Cancel
                        </button>

                    </div>

                </div>

            </form>


            <div class="footer-text">

                University of Benin Teaching Hospital

                <br />

                ICT Unit

            </div>

        </div>

    </div>

</body>

</html>